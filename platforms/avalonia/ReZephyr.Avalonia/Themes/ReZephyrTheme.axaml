<!--
  ReZephyr Avalonia theme resources
  Version: v1.0.0-beta.3 (Build 4)
  Merge into App.axaml: <StyleInclude Source="avares://YourApp/Themes/ReZephyrTheme.axaml" />
  Or copy brushes into your ResourceDictionary.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ReZephyrVioletLight" Color="#4924AC" />
  <SolidColorBrush x:Key="ReZephyrVioletDark" Color="#9C84F2" />
  <SolidColorBrush x:Key="ReZephyrOnVioletLight" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ReZephyrOnVioletDark" Color="#120E22" />
  <SolidColorBrush x:Key="ReZephyrPageLight" Color="#F2F1F7" />
  <SolidColorBrush x:Key="ReZephyrPageDark" Color="#0C0B12" />
  <SolidColorBrush x:Key="ReZephyrCardLight" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ReZephyrCardDark" Color="#1A1824" />
  <SolidColorBrush x:Key="ReZephyrSeparatorLight" Color="#E4E2EC" />
  <SolidColorBrush x:Key="ReZephyrSeparatorDark" Color="#2E2B3B" />
  <SolidColorBrush x:Key="ReZephyrTextLight" Color="#16141F" />
  <SolidColorBrush x:Key="ReZephyrTextDark" Color="#F4F3F8" />
  <SolidColorBrush x:Key="ReZephyrTextSecondaryLight" Color="#6E6A7C" />
  <SolidColorBrush x:Key="ReZephyrTextSecondaryDark" Color="#A7A3B5" />
  <SolidColorBrush x:Key="ReZephyrHeartLight" Color="#FF2D55" />
  <SolidColorBrush x:Key="ReZephyrHeartDark" Color="#FF4D6D" />
  <SolidColorBrush x:Key="ReZephyrDangerLight" Color="#E5383B" />
  <SolidColorBrush x:Key="ReZephyrDangerDark" Color="#FF6B6B" />
  <SolidColorBrush x:Key="ReZephyrLimeLight" Color="#B9D334" />
  <SolidColorBrush x:Key="ReZephyrLimeDark" Color="#CFE45A" />

  <x:Double x:Key="ReZephyrButtonPrimaryHeight">52</x:Double>
  <x:Double x:Key="ReZephyrButtonGhostHeight">50</x:Double>
  <x:Double x:Key="ReZephyrFieldHeight">46</x:Double>
  <x:Double x:Key="ReZephyrTouchMin">44</x:Double>
  <x:Double x:Key="ReZephyrRadius16">16</x:Double>
  <x:Double x:Key="ReZephyrRadius20">20</x:Double>
  <x:Double x:Key="ReZephyrRadius28">28</x:Double>
  <CornerRadius x:Key="ReZephyrCornerButton">16</CornerRadius>
  <CornerRadius x:Key="ReZephyrCornerCard">20</CornerRadius>
  <CornerRadius x:Key="ReZephyrCornerSheet">28,28,0,0</CornerRadius>
</ResourceDictionary>
